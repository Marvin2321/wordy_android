<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wordy_blue"
    android:fitsSystemWindows="true"
    tools:context=".RelacionarImagenesActivity"
    tools:ignore="HardcodedText">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glCremaTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.06" />

    <View
        android:id="@+id/bgCrema"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_oval_cream"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/glCremaTop" />

    <include
        android:id="@+id/header"
        layout="@layout/header_wordy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitulo"
        style="@style/WordyTitulo"
        android:layout_marginTop="4dp"
        android:text="@string/titulo_aprende_palabras"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <!-- Imágenes fila 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivBaya"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:contentDescription="@null"
                    android:src="@drawable/img_rel_baya" />

                <ImageView
                    android:id="@+id/ivAjeno"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:contentDescription="@null"
                    android:src="@drawable/img_rel_ajeno" />

                <ImageView
                    android:id="@+id/ivFenicio"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:contentDescription="@null"
                    android:src="@drawable/img_rel_fenicio" />
            </LinearLayout>

            <!-- Imágenes fila 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivPueril"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:contentDescription="@null"
                    android:src="@drawable/img_rel_pueril" />

                <ImageView
                    android:id="@+id/ivGazapo"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:contentDescription="@null"
                    android:src="@drawable/img_rel_gazapo" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Tarjeta amarilla con las palabras -->
            <LinearLayout
                android:id="@+id/cardRelaciona"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="26dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="34dp">

                <TextView
                    style="@style/WordyCuerpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:justificationMode="inter_word"
                    android:text="@string/relaciona_instruccion"
                    android:textSize="14sp"
                    tools:targetApi="o" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/palabraBaya"
                        style="@style/WordyOpcion"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_field_orange"
                        android:text="Baya" />

                    <TextView
                        android:id="@+id/palabraGazapo"
                        style="@style/WordyOpcion"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_field_teal"
                        android:text="Gazapo" />

                    <TextView
                        android:id="@+id/palabraAjeno"
                        style="@style/WordyOpcion"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_field_purple"
                        android:text="Ajeno" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/palabraPueril"
                        style="@style/WordyOpcion"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_field_pink"
                        android:text="Pueril" />

                    <TextView
                        android:id="@+id/palabraFenicio"
                        style="@style/WordyOpcion"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_field_coral"
                        android:text="Fenicio" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <include
                android:id="@+id/btnDiccionario"
                layout="@layout/chip_diccionario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/footer"
        layout="@layout/footer_home_regresar_revisar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>