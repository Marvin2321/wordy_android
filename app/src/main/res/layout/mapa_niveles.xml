<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ivMapa"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/img_mapa"
        android:scaleType="centerCrop"
        android:src="@drawable/img_mapa_decoracion"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/nivel5"
        style="@style/WordyNivel"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:background="@drawable/ic_estrella_nivel"
        android:text="5"
        android:textColor="@color/wordy_coral_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.657"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.061"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/nivel4"
        style="@style/WordyNivel"
        android:layout_width="77dp"
        android:layout_height="77dp"
        android:background="@drawable/bg_nivel_morado"
        android:text="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.262"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.326"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/nivel3"
        style="@style/WordyNivel"
        android:layout_width="77dp"
        android:layout_height="77dp"
        android:background="@drawable/bg_nivel_rosa"
        android:text="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.815"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.572"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/nivel2"
        style="@style/WordyNivel"
        android:layout_width="77dp"
        android:layout_height="77dp"
        android:background="@drawable/bg_nivel_teal"
        android:text="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.262"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.74"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/nivel1"
        style="@style/WordyNivel"
        android:layout_width="77dp"
        android:layout_height="77dp"
        android:background="@drawable/bg_nivel_naranja"
        android:text="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.691"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.958"
        tools:ignore="HardcodedText" />

</androidx.constraintlayout.widget.ConstraintLayout>