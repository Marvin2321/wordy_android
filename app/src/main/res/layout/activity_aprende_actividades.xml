<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wordy_blue"
    android:fitsSystemWindows="true"
    tools:context=".AprendeActividadesActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glCremaTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.06" />

    <View
        android:id="@+id/bgCielo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_oval_sky_full"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/glCremaTop" />

    <include
        android:id="@+id/header"
        layout="@layout/header_wordy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitulo"
        style="@style/WordyTitulo"
        android:layout_marginTop="4dp"
        android:text="@string/titulo_aprende_palabras"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <TextView
        android:id="@+id/tvSubtitulo"
        style="@style/WordySubtitulo"
        android:layout_marginTop="10dp"
        android:text="@string/subtitulo_actividades"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitulo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="34dp"
            android:paddingEnd="34dp">

            <!-- Tarjeta 1: ejercicios prácticos -->
            <LinearLayout
                android:id="@+id/cardEjercicios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:paddingBottom="22dp">

                <TextView
                    style="@style/WordyCuerpo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ejercicios_practicos"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/ivEjercicios"
                    android:layout_width="300dp"
                    android:layout_height="94dp"
                    android:layout_marginTop="6dp"
                    android:contentDescription="@string/ejercicios_practicos"
                    android:src="@drawable/img_ejercicios_practicos" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEjercicios"
                    style="@style/WordyButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_btn_green"
                    android:fontFamily="@font/fredoka_normal"
                    android:text="@string/jugar"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Tarjeta 2: relacionar con imágenes -->
            <LinearLayout
                android:id="@+id/cardRelacionar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:paddingBottom="22dp">

                <TextView
                    style="@style/WordyCuerpo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/relacionar_imagenes"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/ivRelacionar"
                    android:layout_width="301dp"
                    android:layout_height="85dp"
                    android:layout_marginTop="6dp"
                    android:contentDescription="@string/relacionar_imagenes"
                    android:src="@drawable/img_relacionar_imagenes" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnRelacionar"
                    style="@style/WordyButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_btn_green"
                    android:fontFamily="@font/fredoka_normal"
                    android:text="@string/jugar"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/footer"
        layout="@layout/footer_home_regresar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>